@prefix : <http://example.org/seehub#> .
@prefix s: <http://w3id.org/explainability/sense#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <https://www.w3.org/ns/ssn/> .

:{{ monitored_platform }}_{{ event_type }}_Shape a sh:NodeShape ;
    sh:targetClass :{{ monitored_platform }} ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:prefixes :, s:, sosa:, ssn:;
        sh:construct """
			CONSTRUCT {
				?newRule a s:EventDetection ;
                    s:detectsEventType :{{ event_type }} ;
                    s:hasSTLFormula "{{ "lower_threshold" if p.lower_threshold.type == "SensorValue" else p.lower_threshold.value }} <= ?signal and ?signal <= {{ "upper_threshold" if p.upper_threshold.type == "SensorValue" else p.upper_threshold.value }}" .
                ?newRule s:hasVariable [
                    s:hasName "signal" ;
                    s:bindsTo ?signal_sensor
                ] .
                {% if p.lower_threshold.type == "SensorValue" %}
                ?newRule s:hasVariable [
                    s:hasName "lower_threshold" ;
                    s:bindsTo ?lower_threshold_sensor
                ] .
                {% endif %}
                {% if p.upper_threshold.type == "SensorValue" %}
                ?newRule s:hasVariable [
                    s:hasName "upper_threshold" ;
                    s:bindsTo ?upper_threshold_sensor
                ] .
                {% endif %}
                ?signal_sensor ssn:implements ?newRule .
			}
			WHERE {
                $this sosa:hosts ?signal_sensor .
                ?signal_sensor s:hasSensorType :{{ monitored_signal }} .
                {% if p.lower_threshold.type == "SensorValue" %}
                {
                    $this sosa:hosts ?lower_threshold_sensor .
                }
                UNION
                {
                    ?parent sosa:hosts+ $this .
                    ?parent sosa:hosts ?lower_threshold_sensor .
                }
                ?lower_threshold_sensor s:hasSensorType :{{ p.lower_threshold.value }} .
                {% endif %}
                {% if p.upper_threshold.type == "SensorValue" %}
                {
                    $this sosa:hosts ?upper_threshold_sensor .
                }
                UNION
                {
                    ?parent sosa:hosts+ $this .
                    ?parent sosa:hosts ?upper_threshold_sensor .
                }
                ?upper_threshold_sensor s:hasSensorType :{{ p.upper_threshold.value }} .
                {% endif %}
				BIND(IRI(CONCAT(str($this), "_{{ event_type }}")) AS ?newRule)
			}
        """ ;
    ] .