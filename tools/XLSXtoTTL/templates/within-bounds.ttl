@prefix : <{{ namespace }}> .
@prefix sense: <http://w3id.org/explainability/sense#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <httpsense://www.w3.org/ns/ssn/> .

:{{ monitored_platform }}_{{ event_type }}_Shape a sh:NodeShape ;
    sh:targetClass sense:PlatformOfInterest ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:prefixes :, sense:, sosa:, ssn:;
        sh:construct """
			CONSTRUCT {
				?newRule a sense:EventDetection ;
                    sense:method "STL" ;
                    sense:definition "{{ "lower_threshold" if p.lower_threshold.type == "SensorValue" else p.lower_threshold.value }} <= signal and signal <= {{ "upper_threshold" if p.upper_threshold.type == "SensorValue" else p.upper_threshold.value }}" .
                ?newRule sense:hasParameterBinding [
                    a sense:ParameterBinding ;
                    sense:parameterName "signal" ;
                    sense:bindsToSensor ?signal_sensor
                ] .
                {% if p.lower_threshold.type == "SensorValue" %}
                ?newRule sense:hasParameterBinding [
                    a sense:ParameterBinding ;
                    sense:parameterName "lower_threshold" ;
                    sense:bindsToSensor ?lower_threshold_sensor
                ] .
                {% endif %}
                {% if p.upper_threshold.type == "SensorValue" %}
                ?newRule sense:hasParameterBinding [
                    a sense:ParameterBinding ;
                    sense:parameterName "upper_threshold" ;
                    sense:bindsToSensor ?upper_threshold_sensor
                ] .
                {% endif %}

                ?signal_sensor ssn:implements ?newRule .
                :{{ event_type }} sense:detectedBy ?newRule .
			}
			WHERE {
                $this sense:hasPlatformType :{{ monitored_platform }} .
                $this sosa:hosts ?signal_sensor .
                ?signal_sensor sosa:observes :{{ monitored_observable_property }} .
                {% if p.lower_threshold.type == "SensorValue" %}
                {
                    $this sosa:hosts ?lower_threshold_sensor .
                }
                UNION
                {
                    ?parent sosa:hosts+ $this .
                    ?parent sosa:hosts ?lower_threshold_sensor .
                }
                ?lower_threshold_sensor sosa:observes :{{ p.lower_threshold.value }} .
                {% endif %}
                {% if p.upper_threshold.type == "SensorValue" %}
                {
                    $this sosa:hosts ?upper_threshold_sensor .
                }
                UNION
                {
                    ?parent sosa:hosts+ $this .
                    ?parent sosa:hosts ?upper_threshold_sensor .
                }
                ?upper_threshold_sensor sosa:observes :{{ p.upper_threshold.value }} .
                {% endif %}
				BIND(IRI(CONCAT(str($this), "_{{ event_type }}")) AS ?newRule)
			}
        """ ;
    ] .